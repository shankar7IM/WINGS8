# ==============================================================================
# WINGS8 Environment Configuration Template
# NOTE: Do NOT store real secret keys in this template or commit production secrets.
# For local development, copy this file to `.env.local` and fill in your test keys.
# ==============================================================================

# Port for local server (defaults to 3000)
PORT=3000

# Razorpay API Credentials
# Obtain these from: Razorpay Dashboard > Settings > API Keys
# Test keys start with 'rzp_test_' while Live keys start with 'rzp_live_'
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Razorpay Webhook Secret
# Obtain when configuring a webhook endpoint at: Razorpay Dashboard > Settings > Webhooks
# Set webhook URL to: https://your-domain.com/api/webhook
# Subscribe to events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Website Owner Admin Authentication Key
# Used to authenticate access to /api/admin/orders
ADMIN_API_KEY=wings8_dev_admin_2026
